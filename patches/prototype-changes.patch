+// Console.ReadLine can block despite its async-looking wrapper. One reader pump
+// owns stdin; cancelling a consent wait must not leave another reader consuming
+// the next transfer's decision. IDs reject late answers after timeout.
+static class UiInput
+{
+    private static readonly Channel<string> Lines = Channel.CreateBounded<string>(new BoundedChannelOptions(32)
+    { SingleReader = true, SingleWriter = true, FullMode = BoundedChannelFullMode.DropOldest });
+
+    static UiInput()
+    {
+        _ = Task.Run(() =>
+        {
+            try { while (Console.ReadLine() is { } line) Lines.Writer.TryWrite(line); }
+            finally { Lines.Writer.TryComplete(); }
+        });
+    }
+
+    public static async ValueTask<string?> ReadLineAsync(CancellationToken ct)
+    {
+        while (await Lines.Reader.WaitToReadAsync(ct))
+            if (Lines.Reader.TryRead(out string? line)) return line;
+        return null;
+    }
+}
