new file mode 100644
index 0000000..e0b64a1
--- /dev/null
+++ b/tests/WinDrop.Protocol.Tests/ConcurrentReceiverTests.cs
@@ -0,0 +1,111 @@
+using System.Threading.Channels;
+using WinDrop.Cli;
+
+namespace WinDrop.Protocol.Tests;
+
+public class ConcurrentReceiverTests
+{
+    [Fact]
+    public async Task Ask_is_handled_while_earlier_discover_connection_remains_open()
+    {
+        var accepted = Channel.CreateUnbounded<Stream>();
+        var discoverStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var askStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var releaseDiscover = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var cancel = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+
+        Task run = ConcurrentReceiver.RunAsync(accepted.Reader.ReadAllAsync(cancel.Token), async (stream, ct) =>
+        {
+            if (stream is TaggedStream { Tag: "discover" })
+            {
+                discoverStarted.SetResult();
+                await releaseDiscover.Task.WaitAsync(ct);
+            }
+            else askStarted.SetResult();
+        }, maxConcurrent: 2, cancel.Token);
+
+        var discover = new TaggedStream("discover");
+        var ask = new TaggedStream("ask");
+        await accepted.Writer.WriteAsync(discover, cancel.Token);
+        await discoverStarted.Task.WaitAsync(cancel.Token);
+        await accepted.Writer.WriteAsync(ask, cancel.Token);
+
+        // This is the regression: the old serial loop waited for Discover to close.
+        await askStarted.Task.WaitAsync(cancel.Token);
+        Assert.False(releaseDiscover.Task.IsCompleted);
+
+        releaseDiscover.SetResult();
+        accepted.Writer.Complete();
+        await run.WaitAsync(cancel.Token);
+        Assert.True(discover.WasDisposed);
+        Assert.True(ask.WasDisposed);
+    }
+
+    [Fact]
+    public async Task Concurrent_limit_holds_extra_connections_until_a_slot_is_free()
+    {
+        var accepted = Channel.CreateUnbounded<Stream>();
+        var firstStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var secondStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var releaseFirst = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var cancel = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+
+        Task run = ConcurrentReceiver.RunAsync(accepted.Reader.ReadAllAsync(cancel.Token), async (stream, ct) =>
+        {
+            if (stream is TaggedStream { Tag: "first" })
+            {
+                firstStarted.SetResult();
+                await releaseFirst.Task.WaitAsync(ct);
+            }
+            else secondStarted.SetResult();
+        }, maxConcurrent: 1, cancel.Token);
+
+        await accepted.Writer.WriteAsync(new TaggedStream("first"), cancel.Token);
+        await firstStarted.Task.WaitAsync(cancel.Token);
+        await accepted.Writer.WriteAsync(new TaggedStream("second"), cancel.Token);
+        await Task.Delay(50, cancel.Token);
+        Assert.False(secondStarted.Task.IsCompleted);
+
+        releaseFirst.SetResult();
+        await secondStarted.Task.WaitAsync(cancel.Token);
+        accepted.Writer.Complete();
+        await run.WaitAsync(cancel.Token);
+    }
+
+    [Fact]
+    public async Task Cancellation_disposes_active_and_waiting_connections()
+    {
+        var accepted = Channel.CreateUnbounded<Stream>();
+        var firstStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var cancel = new CancellationTokenSource(TimeSpan.FromSeconds(5));
+
+        Task run = ConcurrentReceiver.RunAsync(accepted.Reader.ReadAllAsync(cancel.Token), async (_, ct) =>
+        {
+            firstStarted.SetResult();
+            await Task.Delay(Timeout.Infinite, ct);
+        }, maxConcurrent: 1, cancel.Token);
+
+        var first = new TaggedStream("first");
+        var waiting = new TaggedStream("waiting");
+        await accepted.Writer.WriteAsync(first);
+        await firstStarted.Task.WaitAsync(cancel.Token);
+        await accepted.Writer.WriteAsync(waiting);
+        await Task.Delay(50);
+        await cancel.CancelAsync();
+
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => run);
+        Assert.True(first.WasDisposed);
+        Assert.True(waiting.WasDisposed);
+    }
+
+    private sealed class TaggedStream(string tag) : MemoryStream
+    {
+        public string Tag { get; } = tag;
+        public bool WasDisposed { get; private set; }
+        public override ValueTask DisposeAsync()
+        {
+            WasDisposed = true;
+            return base.DisposeAsync();
+        }
+    }
+}
