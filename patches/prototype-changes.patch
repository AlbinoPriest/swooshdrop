--- /dev/null
+++ b/tests/WinDrop.Protocol.Tests/DiscoveryRefreshTests.cs
@@ -0,0 +1,24 @@
+using WinDrop.Protocol.Discovery;
+using WinDrop.Protocol.Dns;
+using Xunit;
+
+namespace WinDrop.Protocol.Tests;
+
+public class DiscoveryRefreshTests
+{
+    [Theory]
+    [InlineData("pc-windrop._airdrop._tcp.local", DnsRecordType.Srv, true)]
+    [InlineData("PC-WINDROP._airdrop._tcp.local", DnsRecordType.Txt, true)]
+    [InlineData("pc-windrop.local", DnsRecordType.Aaaa, true)]
+    [InlineData("pc-windrop.local", DnsRecordType.A, true)]
+    [InlineData("other._airdrop._tcp.local", DnsRecordType.Srv, false)]
+    [InlineData("other.local", DnsRecordType.Aaaa, false)]
+    public void Answers_own_targeted_queries_without_claiming_other_peers(string name, DnsRecordType type, bool expected)
+    {
+        var record = new AirDropServiceRecord("pc-windrop", 8770, AirDropReceiverFlags.SupportsDvZip);
+        var query = new DnsMessage { Questions = { new DnsQuestion(name, type) } };
+        Assert.Equal(expected, AirDropRecords.IsQueryForReceiver(DnsMessage.Parse(query.ToBytes()), record));
+        var response = new DnsMessage { IsResponse = true, Questions = { new DnsQuestion(name, type) } };
+        Assert.False(AirDropRecords.IsQueryForReceiver(response, record));
+    }
+}
