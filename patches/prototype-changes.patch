index 0000000..c64e340
--- /dev/null
+++ b/src/WinDrop.Cli/ConcurrentReceiver.cs
@@ -0,0 +1,63 @@
+namespace WinDrop.Cli;
+
+/// <summary>
+/// Handles independent AirDrop TLS sessions concurrently. iOS can open /Ask while an
+/// earlier /Discover connection is still idle; serial handling makes that /Ask time out.
+/// </summary>
+internal static class ConcurrentReceiver
+{
+    public static async Task RunAsync(
+        IAsyncEnumerable<Stream> connections,
+        Func<Stream, CancellationToken, Task> handle,
+        int maxConcurrent,
+        CancellationToken ct)
+    {
+        if (maxConcurrent < 1) throw new ArgumentOutOfRangeException(nameof(maxConcurrent));
+
+        using var slots = new SemaphoreSlim(maxConcurrent);
+        var inFlight = new HashSet<Task>();
+
+        try
+        {
+            await foreach (Stream raw in connections.WithCancellation(ct))
+            {
+                try
+                {
+                    // Observe completed workers before forgetting them. A long-lived
+                    // receiver cannot retain every finished session indefinitely.
+                    foreach (Task completed in inFlight.Where(static task => task.IsCompleted).ToArray())
+                    {
+                        inFlight.Remove(completed);
+                        await completed;
+                    }
+
+                    await slots.WaitAsync(ct);
+                }
+                catch
+                {
+                    await raw.DisposeAsync();
+                    throw;
+                }
+
+                // Async work begins immediately. A held-open /Discover no longer blocks
+                // the next connection's TLS handshake or /Ask request.
+                Task worker = HandleOneAsync(raw);
+                inFlight.Add(worker);
+            }
+        }
+        finally
+        {
+            await Task.WhenAll(inFlight);
+        }
+
+        async Task HandleOneAsync(Stream raw)
+        {
+            try { await handle(raw, ct); }
+            finally
+            {
+                await raw.DisposeAsync();
+                slots.Release();
+            }
+        }
+    }
+}
