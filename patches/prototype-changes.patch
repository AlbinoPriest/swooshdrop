+// A single stdin pump routes each response to its transfer ID. Concurrent /Ask
+// sessions must not steal each other's Accept/Decline responses.
+static class UiInput
+{
+    public static Action<JsonElement>? CommandHandler { get; set; }
+    private static readonly ConcurrentDictionary<string, TaskCompletionSource<bool>> Pending = new();
+
+    static UiInput()
+    {
+        _ = Task.Run(() =>
+        {
+            try
+            {
+                while (Console.ReadLine() is { } line)
+                {
+                    try
+                    {
+                        using var json = JsonDocument.Parse(line);
+                        var root = json.RootElement;
+                        if (root.TryGetProperty("op", out _)) { CommandHandler?.Invoke(root); continue; }
+                        string? id = root.GetProperty("id").GetString();
+                        bool accepted = root.GetProperty("accept").GetBoolean();
+                        if (id is not null && Pending.TryGetValue(id, out var waiter))
+                            waiter.TrySetResult(accepted);
+                    }
+                    catch (Exception ex) when (ex is JsonException or InvalidOperationException or KeyNotFoundException) { }
+                }
+            }
+            finally { foreach (var waiter in Pending.Values) waiter.TrySetResult(false); }
