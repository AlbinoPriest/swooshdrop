+++ b/tests/test_bridge_relay.py
@@ -0,0 +1,45 @@
+"""Regression tests for the AirDrop bridge's bidirectional TCP relay."""
+
+import importlib.util
+import pathlib
+import socket
+import unittest
+
+
+MODULE = pathlib.Path(__file__).resolve().parents[1] / "tools" / "windrop-bridge.py"
+spec = importlib.util.spec_from_file_location("windrop_bridge", MODULE)
+bridge = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(bridge)
+
+
+class RelayTests(unittest.TestCase):
+    def test_peer_half_close_keeps_reverse_response_open(self):
+        peer, peer_bridge = socket.socketpair()
+        controller_bridge, controller = socket.socketpair()
+        sockets = (peer, peer_bridge, controller_bridge, controller)
+        for sock in sockets:
+            sock.settimeout(2)
+
+        try:
+            # The relay method only needs its sequence counter; no radio is involved.
+            relay = bridge.Bridge.__new__(bridge.Bridge)
+            relay.relay_numbers = iter(range(1, 100))
+            relay.couple(peer_bridge, controller_bridge, "test")
+
+            peer.sendall(b"ask")
+            peer.shutdown(socket.SHUT_WR)
+            self.assertEqual(controller.recv(3), b"ask")
+            self.assertEqual(controller.recv(1), b"")
+
+            # The old bridge closed both sockets at the first EOF, losing this reply.
+            controller.sendall(b"accepted")
+            controller.shutdown(socket.SHUT_WR)
+            self.assertEqual(peer.recv(8), b"accepted")
+            self.assertEqual(peer.recv(1), b"")
+        finally:
+            for sock in sockets:
+                sock.close()
+
+
+if __name__ == "__main__":
+    unittest.main()
