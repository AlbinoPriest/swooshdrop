<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwooshDrop" Width="1080" Height="740" MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#101419"
        FontFamily="Segoe UI" Foreground="#EDF2EF">
 <Window.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#101419"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1A2025"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="#242B2F"/>
  <SolidColorBrush x:Key="LineBrush" Color="#374046"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A5B3B4"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#C8EF70"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="16,10"/>
   <Setter Property="Background" Value="#242B2F"/>
   <Setter Property="Foreground" Value="#EDF2EF"/>
   <Setter Property="BorderBrush" Value="#435057"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="#EDF2EF"/>
   <Setter Property="Margin" Value="0,6"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="CheckBox">
     <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#252F2E"
               BorderBrush="#7A8D85" BorderThickness="1">
        <Path x:Name="Tick" Data="M 3,9 L 7,13 L 15,5" Stroke="#172018" StrokeThickness="2.3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Visibility="Collapsed"/>
       </Border>
       <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
                         VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Box" Property="Background" Value="#C8EF70"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="#C8EF70"/>
       <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#C8EF70"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#C8EF70"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusRing" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Grid Background="#1A2025" Width="10">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Maximum="{TemplateBinding Maximum}"
             Minimum="{TemplateBinding Minimum}" Value="{TemplateBinding Value}"
             ViewportSize="{TemplateBinding ViewportSize}">
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb>
         <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#596967" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template>
        </Thumb>
       </Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#151A1E" BorderBrush="#30383B" BorderThickness="0,0,1,0">
   <Grid Margin="22,26,18,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Grid Width="48" Height="48" HorizontalAlignment="Left">
      <Border Background="#C8EF70" CornerRadius="13"/>
      <TextBlock Text="↘" Foreground="#172018" FontFamily="Segoe UI Symbol" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
     </Grid>
     <TextBlock Text="SwooshDrop" FontSize="24" FontWeight="SemiBold" Margin="0,17,0,4"/>
     <TextBlock Text="IPHONE  →  WINDOWS" FontSize="10" FontWeight="SemiBold" Foreground="#A5B3B4"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,52,0,0">
     <TextBlock Text="WORKSPACE" Foreground="#7F9193" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,12"/>
     <Button x:Name="ReceivedNav" Content="↓    Received" HorizontalContentAlignment="Left" Background="#303B3A" Foreground="#DDF3AB" BorderThickness="0" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Content="⚙    Settings" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B7C3C3" BorderThickness="0" Margin="0,0,0,8"/>
     <Button x:Name="AboutNav" Content="ⓘ    About" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#B7C3C3" BorderThickness="0"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Border Background="#202927" BorderBrush="#405048" BorderThickness="1" CornerRadius="10" Padding="13">
      <StackPanel>
       <TextBlock Text="READY FOR YOUR NEXT DROP" Foreground="#C8EF70" FontWeight="SemiBold" FontSize="10"/>
       <TextBlock Text="Share straight from iPhone." Foreground="#B9C8C1" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <TextBlock Text="SwooshDrop 0.3.4 beta" Foreground="#819294" FontSize="10" Margin="0,16,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,29,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Your AirDrop workspace" FontSize="30" FontWeight="SemiBold"/>
     <TextBlock Text="Send from iPhone. Receive on Windows." FontSize="13" Foreground="#A5B3B4" Margin="0,5,0,0"/>
    </StackPanel>
    <Button x:Name="FolderButton" Grid.Column="1" Content="Open folder  ↗" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
           BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,24,0,25">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#819294" Margin="0,0,11,0"/>
       <TextBlock x:Name="StatusText" Text="Ready when you are" FontSize="15" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="StatusDetail" Text="Connect your adapter and start receiving." Foreground="{StaticResource MutedBrush}"
                 FontSize="12" Margin="20,7,16,0" TextWrapping="Wrap" MaxWidth="425"/>
     </StackPanel>
     <Button x:Name="ReceiveButton" Grid.Column="1" Content="Start receiving" Background="#C8EF70" Foreground="#182219"
             BorderThickness="0" VerticalAlignment="Center" MinWidth="150"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <Grid x:Name="ReceivedPage">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,15">
      <TextBlock Text="YOUR TRANSFERS" Foreground="#C5D4D0" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock x:Name="CountText" Text="0 items" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
     </Grid>
     <Border x:Name="PendingBanner" Grid.Row="1" Background="#27332C" BorderBrush="#5B794A" BorderThickness="1"
             CornerRadius="10" Padding="14" Visibility="Collapsed" Margin="0,0,0,15">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="PendingText" Text="Incoming AirDrop" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#EDF2EF"/>
       <Button x:Name="BannerDecline" Grid.Column="1" Content="Decline" Margin="10,0,8,0" Padding="12,7"/>
       <Button x:Name="BannerAccept" Grid.Column="2" Content="Accept" Background="#C8EF70" Foreground="#182219" BorderThickness="0" Padding="12,7"/>
      </Grid>
     </Border>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
       <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0">
        <Border Background="#263129" BorderBrush="#455A3C" BorderThickness="1" Width="88" Height="88" CornerRadius="26">
         <TextBlock Text="↘" Foreground="#C8EF70" FontFamily="Segoe UI Symbol" FontSize="49" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>
        </Border>
        <TextBlock Text="Waiting for a drop" FontSize="20" FontWeight="SemiBold" Margin="0,21,0,8" HorizontalAlignment="Center"/>
        <TextBlock Text="On iPhone: Share → AirDrop → SwooshDrop" Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
       </StackPanel>
       <ItemsControl x:Name="Transfers">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border Width="218" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="10" Margin="0,0,13,15" ClipToBounds="True">
           <StackPanel>
            <Border Background="#252E30" Height="123" CornerRadius="9,9,0,0" ClipToBounds="True">
             <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
               <TextBlock Text="{Binding Glyph}" FontSize="32" Foreground="#C8EF70" HorizontalAlignment="Center"/>
               <TextBlock Text="{Binding Kind}" Foreground="#B9C8C1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
              <Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/>
             </Grid>
            </Border>
            <StackPanel Margin="13,13,13,13">
             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
             <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Sender}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextTrimming="CharacterEllipsis"/>
             <Grid>
              <Button Content="Open" Tag="{Binding}" Padding="10,6" FontSize="11" HorizontalAlignment="Left"/>
              <Button Content="Show in folder" Tag="{Binding}" Padding="6,6" FontSize="10" HorizontalAlignment="Right"
                      BorderThickness="0" Background="Transparent" Foreground="#C8EF70"/>
             </Grid>
            </StackPanel>
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </ScrollViewer>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="Settings" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
       <StackPanel>
        <TextBlock Text="STARTUP &amp; NOTIFICATIONS" FontSize="10" Foreground="#C8EF70" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox x:Name="AutostartCheck" Content="Start SwooshDrop when I sign in to Windows"/>
        <CheckBox x:Name="ReceiveOnLaunchCheck" Content="Start receiving when SwooshDrop opens"/>
        <CheckBox x:Name="NotificationsCheck" Content="Show photo and link previews in notifications"/>
        <CheckBox x:Name="OpenLinksCheck" Content="Open accepted web links in my browser"/>
        <TextBlock Text="Every transfer still needs your approval." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="22" Margin="0,16,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
       <StackPanel>
        <TextBlock Text="SAVE FILES TO" FontSize="10" Foreground="#C8EF70" FontWeight="SemiBold"/>
        <TextBlock x:Name="SaveFolderText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,14"/>
        <Button x:Name="ChangeFolderButton" Content="Choose folder…" HorizontalAlignment="Left"/>
        <TextBlock Text="Changing folders takes effect after Stop → Start." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
        <Button x:Name="SetupButton" Content="Adapter setup…" HorizontalAlignment="Left" Margin="0,16,0,0"/>
        <TextBlock Text="Stops receiving and opens setup to change your USB adapter." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="About SwooshDrop" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
       <StackPanel>
        <TextBlock Text="SwooshDrop 0.3.4 beta" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Receive photos, files, and web links from the native AirDrop menu on your iPhone." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,10,0,16"/>
        <TextBlock Text="Unofficial community project" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock Text="Developed independently by AlbinoPriest. Not affiliated with, sponsored by, or endorsed by Apple, Microsoft, or the upstream WinDrop and OWL maintainers." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,14"/>
        <TextBlock Text="AirDrop protocol adapted from MIT-licensed WinDrop by Uvejs Gjelaj. AWDL provided by OWL under GPL-3.0. Original copyright and license notices are retained; see Licenses below." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>
        <TextBlock Text="Hardware beta" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock Text="Uses a dedicated compatible USB adapter and a separate Linux runtime installed by SwooshDrop Setup. Discovery can take time. Experimental adapters and fresh Windows installations still need testing. Contacts Only is not supported." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,18"/>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="DiagnosticsButton" Content="Open diagnostics"/>
         <Button x:Name="LicensesButton" Content="Licenses" Margin="10,0,0,0"/>
        </StackPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="3" Text="Files keep their original quality. Closing this window keeps receiving in the tray."
              FontSize="10" Foreground="#8B9B9C" Margin="0,15,0,0"/>
  </Grid>
 </Grid>
</Window>
