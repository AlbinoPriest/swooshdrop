<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WinDrop" Width="1080" Height="740" MinWidth="850" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Segoe UI" Foreground="#17253D">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="18,11"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17253D"/><Setter Property="BorderBrush" Value="#DFE6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,9"/></Style>
 </Window.Resources>
 <Grid Background="#F4F7FB"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14213A"><Grid Margin="22,28,18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="#337AF5" Width="48" Height="48" CornerRadius="16" HorizontalAlignment="Left"><TextBlock Text="↓" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="WinDrop" Foreground="White" FontWeight="SemiBold" FontSize="26" Margin="0,14,0,3"/><TextBlock Text="FROM PHONE TO PC" FontSize="9" Foreground="#91A3C3"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,42,0,0"><Button x:Name="ReceivedNav" Content="↓    Received" HorizontalContentAlignment="Left" Background="#263957" Foreground="White" BorderThickness="0" Margin="0,0,0,9"/><Button x:Name="SettingsNav" Content="⚙    Settings" Background="Transparent" Foreground="#BECCE2" BorderThickness="0" Margin="0,0,0,9"/><Button x:Name="AboutNav" Content="ⓘ    About" Background="Transparent" Foreground="#BECCE2" BorderThickness="0"/></StackPanel>
   <StackPanel Grid.Row="3"><Border Background="#20314D" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="Native AirDrop" Foreground="#D8E6FF" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="No phone app needed" Foreground="#91A3C3" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border><TextBlock Text="WinDrop 0.3 beta · Hardware beta" Foreground="#8294B4" FontSize="10" Margin="0,16,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="32,30,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="A little closer together." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your iPhone files, right here on Windows." FontSize="13" Foreground="#6B7C96" Margin="0,6,0,0"/></StackPanel><Button x:Name="FolderButton" Grid.Column="1" Content="Open folder  ↗" VerticalAlignment="Center"/></Grid>
   <Border Grid.Row="1" Background="White" BorderBrush="#E4EAF3" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,25,0,25"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9AA8BE" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="Ready when you are" FontSize="15" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StatusDetail" Text="Connect your adapter and start receiving." Foreground="#7888A1" FontSize="12" Margin="17,7,0,0" TextWrapping="Wrap" MaxWidth="410"/></StackPanel><Button x:Name="ReceiveButton" Grid.Column="1" Content="Start receiving" Background="#337AF5" Foreground="White" BorderThickness="0" VerticalAlignment="Center" MinWidth="145"/></Grid></Border>
   <Grid Grid.Row="2">
    <Grid x:Name="ReceivedPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,14"><TextBlock Text="Received" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="0 items" HorizontalAlignment="Right" Foreground="#7888A1" VerticalAlignment="Center"/></Grid>
     <Border x:Name="PendingBanner" Grid.Row="1" Background="#E7EFFE" CornerRadius="10" Padding="14" Visibility="Collapsed" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PendingText" Text="Incoming AirDrop" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="BannerDecline" Grid.Column="1" Content="Decline" Margin="10,0,8,0" Padding="12,7"/><Button x:Name="BannerAccept" Grid.Column="2" Content="Accept" Background="#337AF5" Foreground="White" BorderThickness="0" Padding="12,7"/></Grid></Border>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,55,0,0"><Border Background="#E8EFFB" Width="90" Height="90" CornerRadius="30"><TextBlock Text="↓" Foreground="#337AF5" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-8,0,0"/></Border><TextBlock Text="Your next drop lands here" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8" HorizontalAlignment="Center"/><TextBlock Text="On iPhone, choose Share → AirDrop → WinDrop PC." Foreground="#7888A1" FontSize="13" HorizontalAlignment="Center"/></StackPanel>
       <ItemsControl x:Name="Transfers"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="222" Background="White" BorderBrush="#E3EAF4" BorderThickness="1" CornerRadius="12" Margin="0,0,14,16" ClipToBounds="True"><StackPanel>
        <Border Background="#EAF0FA" Height="124" CornerRadius="11,11,0,0" ClipToBounds="True"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Glyph}" FontSize="31" Foreground="#527BB7" HorizontalAlignment="Center"/><TextBlock Text="{Binding Kind}" Foreground="#7A8EAE" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel><Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Margin="14,13,14,14"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#7888A1" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Sender}" FontSize="10" Foreground="#7888A1" Margin="0,3,0,10" TextTrimming="CharacterEllipsis"/><Grid><Button Content="Open" Tag="{Binding}" Padding="11,6" FontSize="11" HorizontalAlignment="Left"/><Button Content="Show in folder" Tag="{Binding}" Padding="8,6" FontSize="10" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" Foreground="#337AF5"/></Grid></StackPanel>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Grid>
     </ScrollViewer>
    </Grid>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="Make yourself at home" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Background="White" CornerRadius="12" Padding="22" BorderBrush="#E3EAF4" BorderThickness="1"><StackPanel><TextBlock Text="STARTUP &amp; NOTIFICATIONS" FontSize="10" Foreground="#7888A1" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox x:Name="AutostartCheck" Content="Start WinDrop when I sign in to Windows"/><CheckBox x:Name="ReceiveOnLaunchCheck" Content="Start receiving when WinDrop opens"/><CheckBox x:Name="NotificationsCheck" Content="Show photo and link previews in notifications"/><CheckBox x:Name="OpenLinksCheck" Content="Open accepted web links in my browser"/><TextBlock Text="Every transfer still needs your approval." Foreground="#7888A1" FontSize="12" Margin="0,9,0,0"/></StackPanel></Border><Border Background="White" CornerRadius="12" Padding="22" Margin="0,16,0,0" BorderBrush="#E3EAF4" BorderThickness="1"><StackPanel><TextBlock Text="SAVE FILES TO" FontSize="10" Foreground="#7888A1" FontWeight="SemiBold"/><TextBlock x:Name="SaveFolderText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,14"/><Button x:Name="ChangeFolderButton" Content="Choose folder…" HorizontalAlignment="Left"/><TextBlock Text="Changing folders takes effect after Stop → Start." FontSize="11" Foreground="#7888A1" Margin="0,12,0,0"/><Button x:Name="SetupButton" Content="Adapter setup…" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock Text="Stops receiving and opens setup to change your USB adapter." FontSize="11" Foreground="#7888A1" Margin="0,9,0,0"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="AboutPage" Visibility="Collapsed"><TextBlock Text="Small app. A real connection." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Background="White" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="WinDrop 0.3 beta" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Receive photos, files, and web links from the native AirDrop menu on your iPhone." TextWrapping="Wrap" Foreground="#6B7C96" FontSize="13" Margin="0,10,0,16"/><TextBlock Text="Unofficial community project" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Developed independently by AlbinoPriest. Not affiliated with, sponsored by, or endorsed by Apple, Microsoft, or the upstream WinDrop and OWL maintainers." TextWrapping="Wrap" Foreground="#6B7C96" FontSize="12" Margin="0,7,0,14"/><TextBlock Text="AirDrop protocol adapted from MIT-licensed WinDrop by Uvejs Gjelaj. AWDL provided by OWL under GPL-3.0. Original copyright and license notices are retained; see Licenses below." TextWrapping="Wrap" Foreground="#6B7C96" FontSize="12" Margin="0,0,0,18"/><TextBlock Text="Hardware beta" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Uses a dedicated compatible USB adapter and a separate Linux runtime installed by WinDrop Setup. Discovery can take time. Experimental adapters and fresh Windows installations still need testing. Contacts Only is not supported." TextWrapping="Wrap" Foreground="#6B7C96" FontSize="12" Margin="0,7,0,18"/><StackPanel Orientation="Horizontal"><Button x:Name="DiagnosticsButton" Content="Open diagnostics"/><Button x:Name="LicensesButton" Content="Licenses" Margin="10,0,0,0"/></StackPanel></StackPanel></Border></StackPanel>
   </Grid>
   <TextBlock Grid.Row="3" Text="Original files stay original. Close this window to keep receiving in the tray." FontSize="10" Foreground="#8B9AB1" Margin="0,15,0,0"/>
  </Grid>
 </Grid>
</Window>
