<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming transfer — SwooshDrop" Width="390" Height="424"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="#F1EDE8" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Background" Value="#292D33"/>
   <Setter Property="Foreground" Value="#F1EDE8"/>
   <Setter Property="BorderBrush" Value="#363A41"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F39485"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
 <Border x:Name="PopupSurface" Background="#202328" BorderBrush="#363A41" BorderThickness="1" CornerRadius="22" Padding="20" Margin="6">
  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.42"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Viewbox Width="24" Height="24" VerticalAlignment="Center"><Canvas Width="64" Height="64"><Path Data="{DynamicResource ThroughGeometry}" Stroke="#F39485" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
    <TextBlock Grid.Column="1" Text="SWOOSHDROP / INCOMING" Foreground="#B2B0B0" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" Margin="9,0,0,0"/>
    <TextBlock x:Name="CountdownText" Grid.Column="2" Text="55s" Foreground="#B2B0B0" FontSize="11" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,17,0,15">
    <TextBlock Text="Incoming AirDrop" FontFamily="Georgia" FontSize="26"/>
    <TextBlock x:Name="SenderText" Text="Your iPhone wants to share" Foreground="#B2B0B0" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#292D33" BorderBrush="#363A41" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid>
     <Viewbox x:Name="PreviewGlyph" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="64" Height="64"><Path Data="{DynamicResource ThroughGeometry}" Stroke="#F39485" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
     <Image x:Name="PreviewImage" Stretch="Uniform"/>
     <TextBox x:Name="LinkText" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True"
              FontSize="14" Foreground="#F39485" CaretBrush="#F39485" Margin="16" VerticalAlignment="Center" Visibility="Collapsed"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,14,0,14">
    <TextBlock x:Name="FilesText" Text="Photo.heic" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="Only accept a transfer you expect." FontSize="11" Foreground="#B2B0B0" Margin="0,5,0,0"/>
   </StackPanel>
   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="DeclineButton" Content="Decline" Height="40"/>
    <Button x:Name="AcceptButton" Grid.Column="2" Content="Accept" Height="40" Background="#F39485" Foreground="#241B1B" BorderThickness="0"/>
   </Grid>
  </Grid>
 </Border>
 </Grid>
</Window>
