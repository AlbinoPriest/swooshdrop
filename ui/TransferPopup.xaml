<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming AirDrop — SwooshDrop" Width="390" Height="490"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="#EDF2EF">
 <Border Background="#1A2025" BorderBrush="#46534C" BorderThickness="1" CornerRadius="15" Padding="22">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="↘  SWOOSHDROP" Foreground="#C8EF70" FontSize="11" FontWeight="SemiBold"/>
    <TextBlock x:Name="CountdownText" Text="55s" Foreground="#A5B3B4" FontSize="11" HorizontalAlignment="Right"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,17,0,17">
    <TextBlock Text="Incoming AirDrop" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="SenderText" Text="Your iPhone wants to share" Foreground="#B0BDBB" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <Border Grid.Row="2" Background="#252E30" BorderBrush="#3E4A4C" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid>
     <TextBlock x:Name="PreviewGlyph" Text="↘" FontSize="58" Foreground="#8CA764" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Image x:Name="PreviewImage" Stretch="Uniform"/>
     <TextBox x:Name="LinkText" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True"
              FontSize="15" Foreground="#C8EF70" CaretBrush="#C8EF70" Margin="18" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
   </Border>
   <StackPanel Grid.Row="3" Margin="0,15,0,15">
    <TextBlock x:Name="FilesText" Text="Photo.heic" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="Accept only a transfer you expect." FontSize="11" Foreground="#A5B3B4" Margin="0,5,0,0"/>
   </StackPanel>
   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="DeclineButton" Content="Decline" Height="41" Background="#30393D" Foreground="#EDF2EF"
            BorderBrush="#485458" BorderThickness="1" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
    <Button x:Name="AcceptButton" Grid.Column="2" Content="Accept" Height="41" Background="#C8EF70" Foreground="#182219"
            BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
   </Grid>
  </Grid>
 </Border>
</Window>
