<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Incoming AirDrop — WinDrop" Width="390" Height="490" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#17253D">
 <Border Background="White" BorderBrush="#DEE6F1" BorderThickness="1" CornerRadius="18" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><TextBlock Text="↓   WinDrop" Foreground="#337AF5" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="CountdownText" Text="55s" Foreground="#8B9AB1" FontSize="11" HorizontalAlignment="Right"/></Grid>
  <StackPanel Grid.Row="1" Margin="0,16,0,16"><TextBlock Text="Incoming AirDrop" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SenderText" Text="Your iPhone wants to share" Foreground="#7888A1" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  <Border Grid.Row="2" Background="#EDF2FA" CornerRadius="10" ClipToBounds="True"><Grid><TextBlock x:Name="PreviewGlyph" Text="↓" FontSize="58" Foreground="#9EB6DA" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBox x:Name="LinkText" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True" FontSize="15" Foreground="#286ADD" Margin="18" VerticalAlignment="Center" Visibility="Collapsed"/></Grid></Border>
  <StackPanel Grid.Row="3" Margin="0,14,0,14"><TextBlock x:Name="FilesText" Text="Photo.heic" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Accept only a transfer you expect." FontSize="11" Foreground="#8B9AB1" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="DeclineButton" Content="Decline" Height="40" Background="#F0F4FA" BorderThickness="0" FontSize="13"/><Button x:Name="AcceptButton" Grid.Column="2" Content="Accept" Height="40" Background="#337AF5" Foreground="White" BorderThickness="0" FontSize="13"/></Grid>
 </Grid></Border>
</Window>
